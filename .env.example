# ===== 火山方舟 =====
# 在 https://console.volcengine.com/ark 获取
ARK_API_KEY=your-ark-api-key
# 账号专属推理接入点 ID（在方舟控制台为对应模型创建）
ARK_SEEDREAM_40_ENDPOINT_ID=your-seedream-4-0-endpoint-id
ARK_SEEDREAM_45_ENDPOINT_ID=your-seedream-4-5-endpoint-id
ARK_SEEDREAM_50_LITE_ENDPOINT_ID=your-seedream-5-0-lite-endpoint-id
ARK_SEEDREAM_50_PRO_ENDPOINT_ID=your-seedream-5-0-pro-endpoint-id
ARK_SEEDANCE_15_PRO_ENDPOINT_ID=your-seedance-1-5-pro-endpoint-id
ARK_SEEDANCE_20_ENDPOINT_ID=your-seedance-2-0-endpoint-id
ARK_SEEDANCE_20_FAST_ENDPOINT_ID=your-seedance-2-0-fast-endpoint-id
# Seedream 5.0 Pro 独立接入点使用的 API Key
ARK_SEEDREAM5_PRO_API_KEY=your-seedream-5-pro-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 认证 =====
# local = 邮箱密码 + 邀请码（默认）；cas = 自行配置的企业 CAS
AUTH_MODE=local
NEXT_PUBLIC_AUTH_MODE=local
# 生成方式：npx auth secret 或 openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret
# 部署后的对外访问地址（登录回跳与通知链接使用）
# AUTH_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# 企业 CAS（仅 AUTH_MODE=cas 时需要）
# CAS_AUTH_URL=https://cas.example.com/verify
# CAS_LOGIN_URL=https://account.example.com/login
# NEXT_PUBLIC_CAS_LOGIN_URL=https://account.example.com/login
# CAS_COOKIE_NAME=SESS_V2
# ORG_EMAIL_DOMAIN=example.com

# ===== 扣子（Coze）插件 =====
# 服务访问令牌（SAT），在扣子编程「API & SDK」页面生成，用于音乐生成 / 语音合成 / 视频剪辑插件
COZE_API_TOKEN=your-coze-sat-token
# 账号对应的插件 ID；公开仓库不提供任何账号专属值
COZE_MUSIC_PLUGIN_ID=your-music-plugin-id
COZE_VIDEO_EDIT_PLUGIN_ID=your-video-edit-plugin-id
COZE_TTS_PLUGIN_ID=your-tts-plugin-id
# COZE_MCP_BASE_URL=https://mcp.coze.cn/v1/plugins
# 媒体中转桶（剪辑工具需要 Coze 云端可拉取素材，经 Supabase Storage 公开桶中转）
SUPABASE_URL=https://your-supabase-endpoint
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# 远端备份写入的环境级门禁。本地和 E2E 必须保持 0；仅生产服务器设为 1。
BACKUP_REMOTE_WRITE_ENABLED=0
# Supabase Storage 单对象上限（字节）。需与控制台 Storage → Settings 保持一致；默认 50 MiB。
MEDIA_BRIDGE_MAX_BYTES=52428800

# ===== ModelScope Qwen3-TTS 声音克隆（实验性，可选） =====
# SDK Token 必须调用 ModelScope 返回的 API 专用域名，不能使用浏览器页面的 ms.show 域名。
# 兼容旧配置；未配置 PUBLIC_URL 时继续作为公共创空间地址使用。
MODELSCOPE_QWEN_TTS_URL=https://studio-qwen-qwen3-tts.api-inference.modelscope.net
# 新配置可显式区分公共地址与自建实例；默认仍使用公共创空间。
# MODELSCOPE_QWEN_TTS_PUBLIC_URL=https://studio-qwen-qwen3-tts.api-inference.modelscope.net
MODELSCOPE_QWEN_TTS_DEFAULT_INSTANCE=public
# 自建 Gradio/Qwen3-TTS 实例（可选）。配置后，创作器可在公共创空间与自建实例间切换。
# MODELSCOPE_QWEN_TTS_SELF_HOSTED_URL=http://127.0.0.1:7860
# 自建实例若需要鉴权可单独配置；未配置时不发送 Authorization，避免复用公共令牌。
# MODELSCOPE_QWEN_TTS_SELF_HOSTED_TOKEN=your-self-hosted-token
# 公共创空间的生成接口要求登录；在 https://modelscope.cn/my/myaccesstoken 创建。
MODELSCOPE_ACCESS_TOKEN=your-modelscope-access-token
# 包含排队、模型加载与生成的总超时（毫秒）
MODELSCOPE_QWEN_TTS_TIMEOUT_MS=600000
# 创作器健康检查超时（毫秒），只检查配置与接口元数据，不会触发模型生成。
MODELSCOPE_QWEN_TTS_HEALTH_TIMEOUT_MS=5000

# ===== 企业微信通知（可选，两种后端任选其一或都配） =====
# 方式一：群机器人 Webhook（最简单，推到固定群）
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 方式二：智能机器人长连接（API 模式，Bot ID + Secret；成员单聊发 ldap 绑定后可直达个人）
# WECOM_BOT_ID=aib-xxxx
# WECOM_BOT_SECRET=xxxx

# ===== 数据目录（SQLite 数据库 + 媒体文件） =====
DATA_DIR=./data

# ===== 生成任务保护 =====
# 单用户同时排队 / 执行的任务数；最近 24 小时用户 / 项目任务额度。设为 0 可关闭对应限制。
TASK_WORKER_CONCURRENCY=2
GENERATION_MAX_ACTIVE_PER_USER=3
GENERATION_MAX_DAILY_PER_USER=100
GENERATION_MAX_DAILY_PER_PROJECT=500

# ===== 超时与轮询兜底（均有默认值，可不配） =====
# 方舟单次 HTTP 请求超时（毫秒），防止挂起连接吃光任务并发槽
ARK_FETCH_TIMEOUT_MS=60000
# Coze MCP 单次调用超时（毫秒）
COZE_RPC_TIMEOUT_MS=120000
# 视频任务最大生存时长（毫秒），超过仍无终态则兜底判失败，避免永久轮询
VIDEO_TASK_MAX_AGE_MS=1800000
# 单个视频缩略图生成超时（毫秒）；FFmpeg 失败时列表会保留占位图，不影响视频播放。
VIDEO_THUMBNAIL_TIMEOUT_MS=20000

# ===== 项目管理回调 (PM callback，可选) =====
# 生成完成后把素材同步到海豚制片管理工具的管线视图；未配置则不同步，不影响生成。
# 制片工具接收接口地址（固定为其域名 + /api/integrations/post-studio/asset）
PM_CALLBACK_URL=https://pm.example.com/api/integrations/post-studio/asset
# 回调鉴权密钥，需与制片工具接收端的回调鉴权配置一致
PM_CALLBACK_SECRET=your-shared-secret
# 本服务私有的公开素材签名密钥，不会发送给制片工具；必须使用独立强随机值
PM_INTEGRATION_SECRET=your-private-asset-signing-secret
